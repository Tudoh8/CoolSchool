  - key: race.second.1
    group: race.second
    speaker: 6
    dutch: Wat een spannende race! Jullie waren allemaal supersnel!
    english: What an exciting race! You were all super fast!
    dutchClip: {fileID: 8300000, guid: f24b7face92a71e438baabe108932c80, type: 3}
    englishClip: {fileID: 0}
  - key: race.end.1
    group: race.end
    speaker: 6
    dutch: Tot de volgende race!
    english: See you at the next race!
    dutchClip: {fileID: 8300000, guid: da6d78b0e1c389d4083aa548f4d8006a, type: 3}
    englishClip: {fileID: 0}
  - key: race.rival.1
    group: race.rival
    speaker: 1
    dutch: Ik ga je inhalen!
    english: I'm going to catch you!
    dutchClip: {fileID: 8300000, guid: b761c5c6577f2ec4584054c7ec8df4f2, type: 3}
    englishClip: {fileID: 0}
  - key: race.rival.2
    group: race.rival
    speaker: 1
    dutch: Wie is er het snelst?
    english: Who's the fastest?
    dutchClip: {fileID: 8300000, guid: 388263a7a82b1784288271c638ac7b94, type: 3}
    englishClip: {fileID: 0}
  - key: race.bump.1
    group: race.bump
    speaker: 1
    dutch: Wiee! Ik draai rondjes!
    english: Wheee! I'm spinning!
    dutchClip: {fileID: 8300000, guid: 98c586251208812409a4029ad47d432b, type: 3}
    englishClip: {fileID: 0}
  - key: race.bump.2
    group: race.bump
    speaker: 1
    dutch: Hihi, botsauto!
    english: Hehe, bumper car!
    dutchClip: {fileID: 8300000, guid: e393128e4de40e7499a20603244af2f9, type: 3}
    englishClip: {fileID: 0}
  - key: aliens.arrive.1
    group: aliens.arrive
    speaker: 0
    dutch: Kijk goed, ze komen overal vandaan!
    english: Look closely, they're coming from everywhere!
    dutchClip: {fileID: 8300000, guid: 47b2cd1b95a375f4b8c34cfd9fb74247, type: 3}
    englishClip: {fileID: 0}
  - key: aliens.big_hint.1
    group: aliens.big_hint
    speaker: 0
    dutch: Wat een grote alien! Flits hem een paar keer!
    english: What a big alien! Zap it a few times!
    dutchClip: {fileID: 8300000, guid: 12729a4e0bd31784f8b8cad776cdda7f, type: 3}
    englishClip: {fileID: 0}
  - key: aliens.big_hit.1
    group: aliens.big_hit
    speaker: 4
    dutch: Hihi, ik krimp!
    english: Hehe, I'm shrinking!
    dutchClip: {fileID: 8300000, guid: 6fa4e3429b0e17041a6f99079cf3ac0a, type: 3}
    englishClip: {fileID: 0}
  - key: aliens.big_hit.2
    group: aliens.big_hit
    speaker: 4
    dutch: Oei, ik word kleiner!
    english: Oops, I'm getting smaller!
    dutchClip: {fileID: 8300000, guid: 35d70f4f163300347930edeee1fbb596, type: 3}
    englishClip: {fileID: 0}
  - key: aliens.tiny_hint.1
    group: aliens.tiny_hint
    speaker: 0
    dutch: Die kleine is snel! Als hij moe is, kun je hem flitsen!
    english: That little one is fast! When he's tired, you can zap him!
    dutchClip: {fileID: 8300000, guid: 9622a153f2cc94a468d67defffccf012, type: 3}
    englishClip: {fileID: 0}
  - key: aliens.tiny_tease.1
    group: aliens.tiny_tease
    speaker: 4
    dutch: Hihi, vang me dan!
    english: Hehe, catch me!
    dutchClip: {fileID: 8300000, guid: 4885924ccd6983146bed7789f1d142a6, type: 3}
    englishClip: {fileID: 0}
  - key: aliens.tiny_tired.1
    group: aliens.tiny_tired
    speaker: 4
    dutch: Pfoe, ik ben moe!
    english: Phew, I'm tired!
    dutchClip: {fileID: 8300000, guid: cb0cb14dea58c674f945d85f39604113, type: 3}
    englishClip: {fileID: 0}
  - key: aliens.shy_hint.1
    group: aliens.shy_hint
    speaker: 0
    dutch: Daar verstopt er eentje! Loop ernaartoe!
    english: One is hiding there! Walk over to it!
    dutchClip: {fileID: 8300000, guid: 475eb30730a25a64eadf65a98747d04f, type: 3}
    englishClip: {fileID: 0}
  - key: aliens.shy_peek.1
    group: aliens.shy_peek
    speaker: 4
    dutch: Kiekeboe!
    english: Peekaboo!
    dutchClip: {fileID: 8300000, guid: 513c33a588d296a4da8563f0471e2932, type: 3}
    englishClip: {fileID: 0}
  - key: aliens.robot_zapped.1
    group: aliens.robot_zapped
    speaker: 4
    dutch: Bliep bliep! Robotdans!
    english: Beep beep! Robot dance!
    dutchClip: {fileID: 8300000, guid: d864905778933524b9568a3bfb55d09c, type: 3}
    englishClip: {fileID: 0}
  - key: aliens.rescue_rocket.1
    group: aliens.rescue_rocket
    speaker: 0
    dutch: Help! De baby-alien zit bovenop de raket! Spring op de trampoline!
    english: Help! The baby alien is on top of the rocket! Jump on the trampoline!
    dutchClip: {fileID: 8300000, guid: a557aa5c80ab0fb469510b8908bded81, type: 3}
    englishClip: {fileID: 0}
  - key: aliens.rescue_bubble.1
    group: aliens.rescue_bubble
    speaker: 0
    dutch: Kijk! De baby-alien zweeft in een bel! Spring omhoog en pak hem!
    english: Look! The baby alien is floating in a bubble! Jump up and grab him!
    dutchClip: {fileID: 8300000, guid: b0d50b5f60b09244891f7eaa9578b72e, type: 3}
    englishClip: {fileID: 0}
  - key: aliens.rescue_slime.1
    group: aliens.rescue_slime
    speaker: 0
    dutch: Oh nee, de baby-alien zit vast in het slijm! Flits het slijm weg!
    english: Oh no, the baby alien is stuck in the slime! Zap the slime away!
    dutchClip: {fileID: 8300000, guid: 21c0f8fca614ed546bfbc94c8f0a1a5e, type: 3}
    englishClip: {fileID: 0}
  - key: aliens.slime_free.1
    group: aliens.slime_free
    speaker: 4
    dutch: Dankjewel! Ik ben weer vrij!
    english: Thank you! I'm free again!
    dutchClip: {fileID: 8300000, guid: 18d1f7a6491b89b44889fc9c6e02ad82, type: 3}
    englishClip: {fileID: 0}
  - key: reward.swap_sword.1
    group: reward.swap_sword
    speaker: 0
    dutch: Wil je je nieuwe zwaard gebruiken?
    english: Do you want to use your new sword?
    dutchClip: {fileID: 8300000, guid: f612d07c0bd48c94691d2e16f2f43495, type: 3}
    englishClip: {fileID: 0}
  - key: reward.swap_shield.1
    group: reward.swap_shield
    speaker: 0
    dutch: Wil je je nieuwe schild gebruiken?
    english: Do you want to use your new shield?
    dutchClip: {fileID: 8300000, guid: 0503b24944107134db0a90e79cec2bde, type: 3}
    englishClip: {fileID: 0}
  - key: reward.swap_hat.1
    group: reward.swap_hat
    speaker: 0
    dutch: Wil je hem meteen opzetten?
    english: Do you want to put it on right away?
    dutchClip: {fileID: 8300000, guid: 075c651601efef649a837d6863cf96ac, type: 3}
    englishClip: {fileID: 0}
  - key: reward.swap_buddy.1
    group: reward.swap_buddy
    speaker: 0
    dutch: Mag je nieuwe knuffel met je mee?
    english: Can your new cuddly toy come along?
    dutchClip: {fileID: 8300000, guid: 6cdeed248ec137b4796807be6afb12af, type: 3}
    englishClip: {fileID: 0}
  - key: reward.swap_yes.1
    group: reward.swap_yes
    speaker: 0
    dutch: Goed gekozen!
    english: Good choice!
    dutchClip: {fileID: 8300000, guid: 5a64445445713c446bafe5017b47c33e, type: 3}
    englishClip: {fileID: 0}
  - key: reward.swap_yes.2
    group: reward.swap_yes
    speaker: 0
    dutch: Super!
    english: Super!
