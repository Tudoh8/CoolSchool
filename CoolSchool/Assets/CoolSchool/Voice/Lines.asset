    englishClip: {fileID: 0}
  - key: number.8.1
    group: number.8
    speaker: 0
    dutch: Acht
    english: Eight
    dutchClip: {fileID: 8300000, guid: 0ca6107937396c940b3e72273349bbed, type: 3}
    englishClip: {fileID: 0}
  - key: number.9.1
    group: number.9
    speaker: 0
    dutch: Negen
    english: Nine
    dutchClip: {fileID: 8300000, guid: 49581c6edf3c4e1469a946844ca231fe, type: 3}
    englishClip: {fileID: 0}
  - key: number.10.1
    group: number.10
    speaker: 0
    dutch: Tien
    english: Ten
    dutchClip: {fileID: 8300000, guid: b8a7009840b2ca148a584c391ed446be, type: 3}
    englishClip: {fileID: 0}
  - key: invite.lesson.1
    group: invite.lesson
    speaker: 0
    dutch: De bel gaat! Kom maar naar de klas!
    english: There's the bell! Come to class!
    dutchClip: {fileID: 8300000, guid: 88e904c6ab1ee8e49a4e123ae6efc0b2, type: 3}
    englishClip: {fileID: 0}
  - key: invite.lesson.2
    group: invite.lesson
    speaker: 0
    dutch: Kom naar de klas, we gaan leren! Volg de sterretjes!
    english: Come to class, let's learn! Follow the stars!
    dutchClip: {fileID: 8300000, guid: 81bbb766032b24c47a7a402a1098a507, type: 3}
    englishClip: {fileID: 0}
  - key: lesson.intro.1
    group: lesson.intro
    speaker: 0
    dutch: Welkom in de klas! Vandaag gaan we tellen.
    english: Welcome to class! Today we're going to count.
    dutchClip: {fileID: 8300000, guid: 13f38bf4cd799c945af1cfeb49faed48, type: 3}
    englishClip: {fileID: 0}
  - key: lesson.total.1
    group: lesson.total
    speaker: 0
    dutch: "Het zijn er\u2026"
    english: "There are\u2026"
    dutchClip: {fileID: 8300000, guid: e0966ce7d803af849b5c711d1e281255, type: 3}
    englishClip: {fileID: 0}
  - key: lesson.correct.1
    group: lesson.correct
    speaker: 0
    dutch: Goed zo!
    english: Well done!
    dutchClip: {fileID: 8300000, guid: 4e6c2f1282b9ddb42aa961af00ea2a18, type: 3}
    englishClip: {fileID: 0}
  - key: lesson.correct.2
    group: lesson.correct
    speaker: 0
    dutch: Heel knap!
    english: Very clever!
    dutchClip: {fileID: 8300000, guid: 1df7800681c977542be8bb34bd3f0684, type: 3}
    englishClip: {fileID: 0}
  - key: lesson.correct.3
    group: lesson.correct
    speaker: 0
    dutch: Ja, dat klopt!
    english: Yes, that's right!
    dutchClip: {fileID: 8300000, guid: 40893ddbd3b51264586723aba7e3cb70, type: 3}
    englishClip: {fileID: 0}
  - key: lesson.try_again.1
    group: lesson.try_again
    speaker: 0
    dutch: Bijna! Probeer het nog eens.
    english: Almost! Try again.
    dutchClip: {fileID: 8300000, guid: 3537ff2d5a7d53d4b9f32aeb5eafcfaa, type: 3}
    englishClip: {fileID: 0}
  - key: lesson.hint.1
    group: lesson.hint
    speaker: 0
    dutch: Tel maar mee!
    english: Let's count together!
    dutchClip: {fileID: 8300000, guid: 11f793e12adb96440b2e2746f3198feb, type: 3}
    englishClip: {fileID: 0}
  - key: lesson.find_number.1
    group: lesson.find_number
    speaker: 0
    dutch: "Waar is het getal\u2026"
    english: "Where is the number\u2026"
    dutchClip: {fileID: 8300000, guid: 4bd08cc61ce98764ab4e6d3e0e62c32b, type: 3}
    englishClip: {fileID: 0}
  - key: lesson.outro.1
    group: lesson.outro
    speaker: 0
    dutch: Wat heb jij goed geteld! Hier zijn je sterren.
    english: You counted so well! Here are your stars.
    dutchClip: {fileID: 8300000, guid: c7b47b92dfc082c46848fdf5164acda6, type: 3}
    englishClip: {fileID: 0}
  - key: lesson.powerup.1
    group: lesson.powerup
    speaker: 0
    dutch: En je krijgt een gouden zwaard voor bij het kasteel!
    english: And you get a golden sword for the castle!
    dutchClip: {fileID: 8300000, guid: 89a05a9a1ef679b469be5ccfc3d6a012, type: 3}
    englishClip: {fileID: 0}
  - key: lesson.count.duck.1
    group: lesson.count.duck
    speaker: 0
    dutch: Tel de eendjes! Tik op elk eendje.
    english: Count the ducks! Tap each duck.
    dutchClip: {fileID: 8300000, guid: 32c97de89d95b5f4e978ce40a84110e3, type: 3}
    englishClip: {fileID: 0}
  - key: lesson.count.duck.2
    group: lesson.count.duck
    speaker: 0
    dutch: Kun jij de eendjes tellen? Tik ze maar aan!
    english: Can you count the ducks? Tap them!
    dutchClip: {fileID: 8300000, guid: 1a2ce046e10b6144ba14dbeb6320936e, type: 3}
    englishClip: {fileID: 0}
  - key: lesson.howmany.duck.1
    group: lesson.howmany.duck
    speaker: 0
    dutch: Hoeveel eendjes zie je?
    english: How many ducks can you see?
    dutchClip: {fileID: 8300000, guid: 21cdf7cf29992984f92615661ada4a2e, type: 3}
    englishClip: {fileID: 0}
  - key: lesson.howmany.duck.2
    group: lesson.howmany.duck
    speaker: 0
    dutch: Tel de eendjes. Hoeveel zijn het?
    english: Count the ducks. How many are there?
    dutchClip: {fileID: 8300000, guid: d05f28910f80d3546872081d3424b7c7, type: 3}
    englishClip: {fileID: 0}
  - key: lesson.giveme.duck.1
    group: lesson.giveme.duck
    speaker: 0
    dutch: 'Doe zoveel eendjes in de mand:'
    english: 'Put this many ducks in the basket:'
    dutchClip: {fileID: 8300000, guid: 5d49792e8781a5a4b82d8f1205631fa7, type: 3}
    englishClip: {fileID: 0}
  - key: lesson.count.ball.1
    group: lesson.count.ball
    speaker: 0
    dutch: Tel de ballen! Tik op elke bal.
    english: Count the balls! Tap each ball.
    dutchClip: {fileID: 8300000, guid: 0c99b6b31e0406740b798bd0d0bdb46e, type: 3}
    englishClip: {fileID: 0}
  - key: lesson.count.ball.2
