  - key: invite.pirates.1
    group: invite.pirates
    speaker: 0
    dutch: Ahoi! Het piratenschip wacht op jou!
    english: Ahoy! The pirate ship is waiting for you!
    dutchClip: {fileID: 8300000, guid: ed56f9c3938256d489ef5b7758b34525, type: 3}
    englishClip: {fileID: 0}
  - key: pirates.start.1
    group: pirates.start
    speaker: 5
    dutch: Ahoi, kapitein! Ik ben Lorre de papegaai. Kom aan boord!
    english: Ahoy, captain! I'm Lorre the parrot. Come aboard!
    dutchClip: {fileID: 8300000, guid: 70060ebb6129a7d43a9c94960dbb6e61, type: 3}
    englishClip: {fileID: 0}
  - key: pirates.crew.1
    group: pirates.crew
    speaker: 1
    dutch: Ahoi! Wij varen mee!
    english: Ahoy! We're sailing with you!
    dutchClip: {fileID: 8300000, guid: 50edfee7a0bf77d41aaed13b8b0d1ca7, type: 3}
    englishClip: {fileID: 0}
  - key: pirates.steer.1
    group: pirates.steer
    speaker: 5
    dutch: Jij bent de kapitein! Stuur het schip naar het eiland!
    english: You're the captain! Steer the ship to the island!
    dutchClip: {fileID: 8300000, guid: 56334159c7a881940a4ec7e8f771a10f, type: 3}
    englishClip: {fileID: 0}
  - key: pirates.balloons.1
    group: pirates.balloons
    speaker: 5
    dutch: Kijk! Een skelettenboot vol ballonnen! Tik op de knop. Boem!
    english: Look! A skeleton boat full of balloons! Tap the button. Boom!
    dutchClip: {fileID: 8300000, guid: 43e9928c69b0c89418ca5db421a57aaf, type: 3}
    englishClip: {fileID: 0}
  - key: pirates.cannon_hint.1
    group: pirates.cannon_hint
    speaker: 5
    dutch: Tik op de knop, dan schiet het kanon!
    english: Tap the button to fire the cannon!
    dutchClip: {fileID: 8300000, guid: a7756701ffc1fa54d86acb1547d17357, type: 3}
    englishClip: {fileID: 0}
  - key: pirates.balloons_done.1
    group: pirates.balloons_done
    speaker: 5
    dutch: Alle ballonnen zijn knal! De skeletten varen naar het eiland!
    english: All the balloons popped! The skeletons are sailing to the island!
    dutchClip: {fileID: 8300000, guid: 96ceab25f6e33264dbf5a14fdf9a290b, type: 3}
    englishClip: {fileID: 0}
  - key: pirates.arrive.1
    group: pirates.arrive
    speaker: 5
    dutch: Land in zicht! Iedereen van boord!
    english: Land ahoy! Everybody off the ship!
    dutchClip: {fileID: 8300000, guid: f84eabaf4634cc34d956552fa12580cd, type: 3}
    englishClip: {fileID: 0}
  - key: pirates.skeletons.1
    group: pirates.skeletons
    speaker: 2
    dutch: Arrr! Wij zijn de skelettenpiraten!
    english: Arrr! We're the skeleton pirates!
    dutchClip: {fileID: 8300000, guid: 5fd42f73ef0c42e47b1d20a4c98aa176, type: 3}
    englishClip: {fileID: 0}
  - key: pirates.fight_hint.1
    group: pirates.fight_hint
    speaker: 5
    dutch: Tik op de knop en zwaai met je zwaard!
    english: Tap the button and swing your sword!
    dutchClip: {fileID: 8300000, guid: 3513030c04bf9014a918b4e070abb82c, type: 3}
    englishClip: {fileID: 0}
  - key: pirates.skeleton_friend.1
    group: pirates.skeleton_friend
    speaker: 2
    dutch: Hihi, mijn botjes kriebelen!
    english: Hehe, my bones tickle!
    dutchClip: {fileID: 8300000, guid: c5e998a48170ed94d945d7f2124f6266, type: 3}
    englishClip: {fileID: 0}
  - key: pirates.skeleton_friend.2
    group: pirates.skeleton_friend
    speaker: 2
    dutch: Oeps, ik val uit elkaar! Mag ik bij jullie?
    english: Oops, I fell apart! Can I join you?
    dutchClip: {fileID: 8300000, guid: d99d4c987ca5a5a4db4808658fe58980, type: 3}
    englishClip: {fileID: 0}
  - key: pirates.skeleton_friend.3
    group: pirates.skeleton_friend
    speaker: 2
    dutch: Klik klak, ik ben weer heel! Vrienden?
    english: Clickety-clack, I'm back together! Friends?
    dutchClip: {fileID: 8300000, guid: a13aa8bb8d3bccf4caff67f3ffdcb1b3, type: 3}
    englishClip: {fileID: 0}
  - key: pirates.map.1
    group: pirates.map
    speaker: 5
    dutch: Een schatkaart! Volg de plaatjes naar de schat!
    english: A treasure map! Follow the pictures to the treasure!
    dutchClip: {fileID: 8300000, guid: 2f14fb37358654a4aa9ceb39bea4a286, type: 3}
    englishClip: {fileID: 0}
  - key: pirates.landmark.1
    group: pirates.landmark
    speaker: 5
    dutch: Goed zo! Nu de volgende!
    english: Well done! Now the next one!
    dutchClip: {fileID: 8300000, guid: 27748d7092648b543b3e9d6c37c67419, type: 3}
    englishClip: {fileID: 0}
  - key: pirates.landmark.2
    group: pirates.landmark
    speaker: 5
    dutch: Gevonden! Verder maar!
    english: Found it! Keep going!
    dutchClip: {fileID: 8300000, guid: 81aa32373962b284496a0f189cf26a03, type: 3}
    englishClip: {fileID: 0}
  - key: pirates.dig.1
    group: pirates.dig
    speaker: 5
    dutch: Hier is de X! Tik op de knop om te graven!
    english: Here's the X! Tap the button to dig!
    dutchClip: {fileID: 8300000, guid: 76494fa8735eeb84ab15fb749112d557, type: 3}
    englishClip: {fileID: 0}
  - key: pirates.lock.1
    group: pirates.lock
    speaker: 5
    dutch: "De kist zit op slot! Het slot gaat open met de\u2026"
    english: "The chest is locked! The lock opens with the\u2026"
    dutchClip: {fileID: 8300000, guid: cc0382ff592d9274bb13f995945daf89, type: 3}
    englishClip: {fileID: 0}
  - key: pirates.lock_new.1
    group: pirates.lock_new
    speaker: 5
    dutch: 'Dit is een nieuwe letter! Luister maar:'
    english: 'This is a new letter! Listen:'
    dutchClip: {fileID: 8300000, guid: b8417f98598a41641a709a97e4a1bfcd, type: 3}
    englishClip: {fileID: 0}
  - key: pirates.lock_right.1
    group: pirates.lock_right
    speaker: 5
    dutch: Klik! Het slot is open!
    english: Click! The lock is open!
    dutchClip: {fileID: 8300000, guid: 7eea4be9abf679b4494f9cb4bb8228fe, type: 3}
    englishClip: {fileID: 0}
  - key: pirates.lock_wrong.1
    group: pirates.lock_wrong
    speaker: 5
    dutch: 'Bijna! Luister nog eens:'
    english: 'Almost! Listen again:'
    dutchClip: {fileID: 8300000, guid: f1f35367cb939c84bb821bd4baa6c68d, type: 3}
    englishClip: {fileID: 0}
  - key: pirates.count.1
    group: pirates.count
    speaker: 5
    dutch: Goud! Tik op elke munt, dan tellen we samen!
    english: Gold! Tap every coin and we'll count together!
    dutchClip: {fileID: 8300000, guid: 7711562c590353b409296af71af4635b, type: 3}
    englishClip: {fileID: 0}
  - key: pirates.how_many.1
    group: pirates.how_many
    speaker: 5
    dutch: Hoeveel munten hebben we gevonden?
    english: How many coins did we find?
    dutchClip: {fileID: 8300000, guid: dc174e8d00bc36645a75afc5b27ae449, type: 3}
    englishClip: {fileID: 0}
  - key: pirates.victory.1
    group: pirates.victory
    speaker: 5
    dutch: Hoera! We hebben de schat! Piratenfeest!
    english: Hooray! We found the treasure! Pirate party!
    dutchClip: {fileID: 8300000, guid: 008a192d9f6d37544961e7341fb06468, type: 3}
    englishClip: {fileID: 0}
  - key: quit.ask.1
    group: quit.ask
    speaker: 0
    dutch: Wil je stoppen met dit spel?
    english: Do you want to stop this game?
    dutchClip: {fileID: 8300000, guid: 50bed24dcc5ef7c43a707524f1aae515, type: 3}
    englishClip: {fileID: 0}
  - key: quit.bye.1
    group: quit.bye
    speaker: 0
    dutch: "Ok\xE9! Dan gaan we weer lekker buiten spelen."
    english: Okay! Let's go and play outside again.
    dutchClip: {fileID: 8300000, guid: ac1f1ff96e78c5f40a274ba944b44ea7, type: 3}
    englishClip: {fileID: 0}
  - key: quit.bye.2
    group: quit.bye
    speaker: 0
    dutch: Prima! Je mag altijd weer terugkomen.
    english: Fine! You can always come back.
    dutchClip: {fileID: 8300000, guid: 97264253e6d92b1409fafe269bcc2a7a, type: 3}
    englishClip: {fileID: 0}
  - key: invite.race.1
    group: invite.race
    speaker: 0
    dutch: Wie doet er mee met de zeepkistrace?
