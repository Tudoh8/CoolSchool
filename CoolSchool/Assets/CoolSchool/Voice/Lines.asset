  - key: shop.order.1.green.1
    group: shop.order.1.green
    speaker: 3
    dutch: "E\xE9n groen bolletje."
    english: One green scoop.
    dutchClip: {fileID: 8300000, guid: 70f9549cd047e2f4c9d48025daa84262, type: 3}
    englishClip: {fileID: 0}
  - key: shop.order.2.green.1
    group: shop.order.2.green
    speaker: 3
    dutch: Twee groene bolletjes.
    english: Two green scoops.
    dutchClip: {fileID: 8300000, guid: 73b2628e29ffc9f4285b278015d3a79a, type: 3}
    englishClip: {fileID: 0}
  - key: shop.order.3.green.1
    group: shop.order.3.green
    speaker: 3
    dutch: Drie groene bolletjes.
    english: Three green scoops.
    dutchClip: {fileID: 8300000, guid: 7956579c1e98e5540868e5d7a11a0c1e, type: 3}
    englishClip: {fileID: 0}
  - key: shop.wrong_colour.1
    group: shop.wrong_colour
    speaker: 3
    dutch: Oeps, die kleur niet! Kijk maar naar het plaatje.
    english: Oops, not that colour! Look at the picture.
    dutchClip: {fileID: 8300000, guid: 1b6e9b2b897137f45acadfb0439e47c7, type: 3}
    englishClip: {fileID: 0}
  - key: shop.wrong_colour.2
    group: shop.wrong_colour
    speaker: 3
    dutch: Hmm, welke kleur wil de klant?
    english: Hmm, which colour does the customer want?
    dutchClip: {fileID: 8300000, guid: 783f276baf6a0634eba0feae1fd2388c, type: 3}
    englishClip: {fileID: 0}
  - key: shop.done.1
    group: shop.done
    speaker: 3
    dutch: Klaar! Tel maar mee.
    english: Done! Let's count.
    dutchClip: {fileID: 8300000, guid: 1bb6799e2fae1404294e06ca1ab13928, type: 3}
    englishClip: {fileID: 0}
  - key: shop.serve.1
    group: shop.serve
    speaker: 1
    dutch: Alsjeblieft!
    english: Here you go!
    dutchClip: {fileID: 8300000, guid: 168435b9765a2c544ad97db679cffe95, type: 3}
    englishClip: {fileID: 0}
  - key: shop.thanks.kid.1
    group: shop.thanks.kid
    speaker: 1
    dutch: Mmm, lekker! Dankjewel!
    english: Mmm, yummy! Thank you!
    dutchClip: {fileID: 8300000, guid: dc80b7d9af8cc60409017de31f9e6d46, type: 3}
    englishClip: {fileID: 0}
  - key: shop.thanks.kid.2
    group: shop.thanks.kid
    speaker: 1
    dutch: Jammie! Dankjewel!
    english: Yummy! Thank you!
    dutchClip: {fileID: 8300000, guid: 9582c20e3a202584690e1d7a708ea5ce, type: 3}
    englishClip: {fileID: 0}
  - key: shop.thanks.knight.1
    group: shop.thanks.knight
    speaker: 1
    dutch: Lekker! Nu ben ik nog sterker!
    english: Yummy! Now I'm even stronger!
    dutchClip: {fileID: 8300000, guid: 70f87000d3626d0469e6c02b413a7825, type: 3}
    englishClip: {fileID: 0}
  - key: shop.thanks.alien.1
    group: shop.thanks.alien
    speaker: 4
    dutch: Bliep! Lekker koud! Dankjewel!
    english: Bleep! Nice and cold! Thank you!
    dutchClip: {fileID: 8300000, guid: a0f0f375078a69b46944da1fb07c1874, type: 3}
    englishClip: {fileID: 0}
  - key: shop.thanks.dragon.1
    group: shop.thanks.dragon
    speaker: 2
    dutch: Mmmm! Brrr, koud! Dankjewel!
    english: Mmmm! Brrr, cold! Thank you!
    dutchClip: {fileID: 8300000, guid: 620265b2f718df94dacf01aba36455cb, type: 3}
    englishClip: {fileID: 0}
  - key: shop.pay.1
    group: shop.pay
    speaker: 3
    dutch: Nu betalen! Tik op de muntjes en tel mee.
    english: Time to pay! Tap the coins and count along.
    dutchClip: {fileID: 8300000, guid: a4e753ea0968bdf478452bbb129fc278, type: 3}
    englishClip: {fileID: 0}
  - key: shop.paid.1
    group: shop.paid
    speaker: 3
    dutch: Ka-ching! Goed geteld!
    english: Ka-ching! Well counted!
    dutchClip: {fileID: 8300000, guid: 71a6e0172b156e146b3f8b215adfc5ec, type: 3}
    englishClip: {fileID: 0}
  - key: shop.paid.2
    group: shop.paid
    speaker: 3
    dutch: Alle muntjes zitten in de kassa!
    english: All the coins are in the register!
    dutchClip: {fileID: 8300000, guid: 38d059c843a777a4b82ceb3393755360, type: 3}
    englishClip: {fileID: 0}
  - key: shop.next.1
    group: shop.next
    speaker: 3
    dutch: Daar komt de volgende klant!
    english: Here comes the next customer!
    dutchClip: {fileID: 8300000, guid: a47864f42ca9e5b47bd7d8454e10de10, type: 3}
    englishClip: {fileID: 0}
  - key: shop.hint.1
    group: shop.hint
    speaker: 3
    dutch: Kijk naar het plaatje boven de klant.
    english: Look at the picture above the customer.
    dutchClip: {fileID: 8300000, guid: c68485cf6d5721849a81179869ee9b6e, type: 3}
    englishClip: {fileID: 0}
  - key: shop.end.1
    group: shop.end
    speaker: 0
    dutch: Wat ben jij een goede ijsverkoper! Hier zijn je sterren.
    english: What a good ice cream seller you are! Here are your stars.
    dutchClip: {fileID: 8300000, guid: 63f446f64e79e2549b7e082a3c5b9efb, type: 3}
    englishClip: {fileID: 0}
  - key: lesson.letters.intro.1
    group: lesson.letters.intro
    speaker: 0
    dutch: Welkom in de klas! Vandaag gaan we letters leren.
    english: Welcome to class! Today we're learning letters.
    dutchClip: {fileID: 8300000, guid: d76023d9c298e174ebbff3cc6ce1ae57, type: 3}
    englishClip: {fileID: 0}
  - key: lesson.letters.outro.1
    group: lesson.letters.outro
    speaker: 0
    dutch: Wat heb jij goed geleerd! Hier zijn je sterren.
    english: You learned so well! Here are your stars.
    dutchClip: {fileID: 8300000, guid: 47c9735209097d94fb5e20af6ed5eb36, type: 3}
    englishClip: {fileID: 0}
  - key: letters.new.1
    group: letters.new
    speaker: 0
    dutch: Dit is een nieuwe letter!
    english: This is a new letter!
    dutchClip: {fileID: 8300000, guid: 6e42576134b14b4439461fb1a92c7803, type: 3}
    englishClip: {fileID: 0}
  - key: letters.find.1
    group: letters.find
    speaker: 0
    dutch: "Waar is de\u2026"
    english: "Where is the\u2026"
    dutchClip: {fileID: 8300000, guid: d9f831d27dfce73488109412fb4048df, type: 3}
    englishClip: {fileID: 0}
  - key: letters.starts_with.1
    group: letters.starts_with
    speaker: 0
    dutch: "Wat begint met\u2026"
    english: "What starts with\u2026"
    dutchClip: {fileID: 8300000, guid: 930305f389b243a4b8ff339b3a3eafd2, type: 3}
    englishClip: {fileID: 0}
  - key: letters.begins_with.1
    group: letters.begins_with
    speaker: 0
    dutch: "\u2026begint met\u2026"
    english: "\u2026starts with\u2026"
    dutchClip: {fileID: 8300000, guid: 102c0f268ef28394a9d3555e14a19fe4, type: 3}
    englishClip: {fileID: 0}
  - key: letters.trace.1
    group: letters.trace
    speaker: 0
    dutch: Teken de letter met je vinger. Volg de stippen!
    english: Draw the letter with your finger. Follow the dots!
    dutchClip: {fileID: 8300000, guid: 20a3eb7a2500c2448abb6076856afccf, type: 3}
    englishClip: {fileID: 0}
  - key: letters.trace_done.1
    group: letters.trace_done
    speaker: 0
    dutch: Wat mooi getekend!
    english: Beautifully drawn!
    dutchClip: {fileID: 8300000, guid: d51dfa8f7286f434a9814d47128a37b2, type: 3}
    englishClip: {fileID: 0}
  - key: letters.name.1
    group: letters.name
    speaker: 0
    dutch: Weet je wat hier komt te staan? Jouw naam! Zoek de letters.
    english: Do you know what goes here? Your name! Find the letters.
    dutchClip: {fileID: 8300000, guid: fd2ed0b6c084ad14e88156307c915615, type: 3}
    englishClip: {fileID: 0}
  - key: letters.name_done.1
    group: letters.name_done
    speaker: 0
    dutch: Dat is jouw naam! Knap gedaan!
    english: That's your name! Well done!
    dutchClip: {fileID: 8300000, guid: 88d6f1114dc2907439c49d45b8e00eba, type: 3}
    englishClip: {fileID: 0}
