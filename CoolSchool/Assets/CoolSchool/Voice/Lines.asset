    englishClip: {fileID: 0}
  - key: reward.swap_no.1
    group: reward.swap_no
    speaker: 0
    dutch: "Ok\xE9! Hij wacht op je in je speelgoedkamer."
    english: Okay! It's waiting for you in your toy room.
    dutchClip: {fileID: 8300000, guid: 79257f00aa50bd04993cf4e4f0e9409b, type: 3}
    englishClip: {fileID: 0}
  - key: reward.cart_new.1
    group: reward.cart_new
    speaker: 0
    dutch: Die kun je kiezen bij de race!
    english: You can pick it at the race!
    dutchClip: {fileID: 8300000, guid: f07fdf75a487a8d45b3a34897cf9f947, type: 3}
    englishClip: {fileID: 0}
  - key: reward.medal.1
    group: reward.medal
    speaker: 0
    dutch: Een medaille! Die hangt in je speelgoedkamer.
    english: A medal! It hangs in your toy room.
    dutchClip: {fileID: 8300000, guid: ef100e6e02b36bd4087312562d4cb8b3, type: 3}
    englishClip: {fileID: 0}
  - key: toyroom.invite.1
    group: toyroom.invite
    speaker: 0
    dutch: Kom kijken in je speelgoedkamer!
    english: Come and look in your toy room!
    dutchClip: {fileID: 8300000, guid: 6b3bc60bd56072c4080c64484d65f0b0, type: 3}
    englishClip: {fileID: 0}
  - key: toyroom.welcome.1
    group: toyroom.welcome
    speaker: 3
    dutch: Dit is jouw speelgoedkamer! Hier staat alles wat je hebt verdiend.
    english: This is your toy room! Everything you've earned is here.
    dutchClip: {fileID: 8300000, guid: c7dcbe74f4103e64d800e5502293fdbc, type: 3}
    englishClip: {fileID: 0}
  - key: toyroom.new_item.1
