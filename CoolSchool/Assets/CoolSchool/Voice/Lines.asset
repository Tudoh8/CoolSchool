    english: Found you! The lion!
    dutchClip: {fileID: 8300000, guid: e613ea6284c220c40a54d25cb5428710, type: 3}
    englishClip: {fileID: 0}
  - key: zoo.found.zebra.1
    group: zoo.found.zebra
    speaker: 1
    dutch: Gevonden! De zebra!
    english: Found you! The zebra!
    dutchClip: {fileID: 8300000, guid: 3831de7b99814814b86c72876cb66e56, type: 3}
    englishClip: {fileID: 0}
  - key: zoo.found.crocodile.1
    group: zoo.found.crocodile
    speaker: 1
    dutch: Gevonden! De krokodil!
    english: Found you! The crocodile!
    dutchClip: {fileID: 8300000, guid: 62ecbca0ae67f1b4783d8680da901a3e, type: 3}
