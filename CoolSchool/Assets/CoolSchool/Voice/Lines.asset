    dutchClip: {fileID: 8300000, guid: de9ebe7971975c349a338db111eb4dfd, type: 3}
    englishClip: {fileID: 0}
  - key: lesson.howmany.dino.2
    group: lesson.howmany.dino
    speaker: 0
    dutch: Tel de dino's. Hoeveel zijn het?
    english: Count the dinos. How many are there?
    dutchClip: {fileID: 8300000, guid: c2f384458cc6e9946873e4882607bb40, type: 3}
    englishClip: {fileID: 0}
  - key: lesson.giveme.dino.1
    group: lesson.giveme.dino
    speaker: 0
    dutch: 'Doe zoveel dino''s in de mand:'
    english: 'Put this many dinos in the basket:'
    dutchClip: {fileID: 8300000, guid: e5c6eac93278535428d34b674fe2c3e5, type: 3}
    englishClip: {fileID: 0}
  - key: aliens.start.1
    group: aliens.start
    speaker: 0
    dutch: Kijk! Er landt een raket! Er komen aliens uit! Jij bent de superheld!
    english: Look! A rocket is landing! Aliens are coming out! You're the superhero!
    dutchClip: {fileID: 8300000, guid: 21880483583a1bb43ba4020bced77a13, type: 3}
    englishClip: {fileID: 0}
  - key: aliens.zap_hint.1
    group: aliens.zap_hint
    speaker: 0
    dutch: Tik op de knop, dan flits je met je straalpistool!
    english: Tap the button to zap with your ray gun!
    dutchClip: {fileID: 8300000, guid: d6502dc28ef5ed045bb8c9444145d067, type: 3}
    englishClip: {fileID: 0}
  - key: aliens.slime_warning.1
    group: aliens.slime_warning
    speaker: 1
    dutch: Pas op, slijm!
    english: Watch out, slime!
    dutchClip: {fileID: 8300000, guid: e0154be0a7189284dacaa32c99202aba, type: 3}
    englishClip: {fileID: 0}
  - key: aliens.zapped.1
    group: aliens.zapped
    speaker: 4
    dutch: Wiehoe! Ik wil dansen!
    english: Wheee! I want to dance!
    dutchClip: {fileID: 8300000, guid: 8cf43a594ae40784b8593b1268a40e56, type: 3}
    englishClip: {fileID: 0}
  - key: aliens.zapped.2
    group: aliens.zapped
    speaker: 4
    dutch: Hihi, jij bent mijn vriend!
    english: Hehe, you're my friend!
    dutchClip: {fileID: 8300000, guid: ff66a0dfc3ce9914f9d3f2f412e98f36, type: 3}
    englishClip: {fileID: 0}
  - key: aliens.zapped.3
    group: aliens.zapped
    speaker: 4
    dutch: Bliep bloep, wat leuk!
    english: Bleep bloop, what fun!
    dutchClip: {fileID: 8300000, guid: b220e956584423f4c8985c6f93a7563e, type: 3}
    englishClip: {fileID: 0}
  - key: aliens.rescue.1
    group: aliens.rescue
    speaker: 0
    dutch: Help! De baby-alien zit vast in de boom! Spring op de trampoline!
    english: Help! The baby alien is stuck in the tree! Jump on the trampoline!
    dutchClip: {fileID: 8300000, guid: 277c62fce10020f4782bcd268a7f6229, type: 3}
    englishClip: {fileID: 0}
  - key: aliens.rescued.1
    group: aliens.rescued
    speaker: 0
    dutch: Je hebt hem gered! Wat een held!
    english: You saved him! What a hero!
    dutchClip: {fileID: 8300000, guid: 3ecba28fce48ca947ba5c15a2a66c9a7, type: 3}
    englishClip: {fileID: 0}
  - key: aliens.count.1
    group: aliens.count
    speaker: 0
    dutch: Hoeveel aliens dansen er?
    english: How many aliens are dancing?
    dutchClip: {fileID: 8300000, guid: 129417eb973921b4bad6d4999545f979, type: 3}
    englishClip: {fileID: 0}
  - key: aliens.victory.1
    group: aliens.victory
    speaker: 0
    dutch: Hoera! Alle aliens zijn onze vrienden! Feest!
    english: Hooray! All the aliens are our friends! Party!
    dutchClip: {fileID: 8300000, guid: 5f945234e89890b4bbc59a65cfed4ddc, type: 3}
    englishClip: {fileID: 0}
  - key: invite.aliens.1
    group: invite.aliens
    speaker: 0
    dutch: Kom snel! Er zijn aliens geland!
    english: Come quickly! Aliens have landed!
    dutchClip: {fileID: 8300000, guid: 3b8783f7ecc293b4fbe00660c260c9fd, type: 3}
    englishClip: {fileID: 0}
  - key: knights.golden_sword.1
    group: knights.golden_sword
    speaker: 0
    dutch: Kijk! Je gouden zwaard! Daarmee ben je extra sterk!
    english: Look! Your golden sword! It makes you extra strong!
    dutchClip: {fileID: 8300000, guid: efd8c5380a222e146bead456c0a3d536, type: 3}
    englishClip: {fileID: 0}
  - key: invite.knights.golden.1
    group: invite.knights.golden
    speaker: 0
    dutch: Je gouden zwaard wacht op je bij het kasteel!
    english: Your golden sword is waiting for you at the castle!
    dutchClip: {fileID: 8300000, guid: 2ec3ef66511f17f449919bb9d15adf98, type: 3}
    englishClip: {fileID: 0}
  - key: lesson.powerup_waiting.1
    group: lesson.powerup_waiting
    speaker: 0
    dutch: Je gouden zwaard ligt nog klaar bij het kasteel!
    english: Your golden sword is still waiting at the castle!
    dutchClip: {fileID: 8300000, guid: d70e440ce9441aa40903ed8057416347, type: 3}
    englishClip: {fileID: 0}
  - key: invite.shop.1
    group: invite.shop
    speaker: 0
    dutch: Wie wil er ijsjes verkopen? Kom naar de ijswinkel!
    english: Who wants to sell ice cream? Come to the ice cream shop!
    dutchClip: {fileID: 8300000, guid: fa2494e1379a4334da4538a3b6c1dedd, type: 3}
    englishClip: {fileID: 0}
  - key: invite.shop.2
    group: invite.shop
    speaker: 0
    dutch: Mmm, ijs! Kom jij in de ijswinkel helpen?
    english: Mmm, ice cream! Will you help in the ice cream shop?
    dutchClip: {fileID: 8300000, guid: d5eca635df39f7848a4c5d0052012b7c, type: 3}
    englishClip: {fileID: 0}
  - key: shop.start.1
    group: shop.start
    speaker: 3
    dutch: Jij bent de ijsverkoper! Daar komt je eerste klant.
    english: You're the ice cream seller! Here comes your first customer.
    dutchClip: {fileID: 8300000, guid: 47e344af5e44e294cb3e6c8650f97191, type: 3}
    englishClip: {fileID: 0}
  - key: shop.howto.1
    group: shop.howto
    speaker: 3
    dutch: Pak een bolletje uit de bak en zet het op het hoorntje!
    english: Take a scoop from the tub and put it on the cone!
    dutchClip: {fileID: 8300000, guid: ad3df0290ca4ddd4b826e00fdd83596a, type: 3}
    englishClip: {fileID: 0}
  - key: shop.hello.kid.1
    group: shop.hello.kid
    speaker: 1
    dutch: Hallo! Mag ik een ijsje, alsjeblieft?
    english: Hello! Can I have an ice cream, please?
    dutchClip: {fileID: 8300000, guid: 81e00add29490d545ad03d9b5720b554, type: 3}
    englishClip: {fileID: 0}
  - key: shop.hello.kid.2
    group: shop.hello.kid
    speaker: 1
    dutch: Hoi! Ik heb zin in ijs!
    english: Hi! I'd love an ice cream!
    dutchClip: {fileID: 8300000, guid: e270f020c45ff7947a79edf651b611fe, type: 3}
    englishClip: {fileID: 0}
  - key: shop.hello.knight.1
    group: shop.hello.knight
    speaker: 1
    dutch: Hallo ijsverkoper! Een ijsje voor een dappere ridder!
    english: Hello ice cream seller! An ice cream for a brave knight!
    dutchClip: {fileID: 8300000, guid: 7aa74702170bf384cab5d00a033b2d75, type: 3}
    englishClip: {fileID: 0}
  - key: shop.hello.alien.1
    group: shop.hello.alien
    speaker: 4
    dutch: Bliep bloep! Ijsje, alsjeblieft!
    english: Bleep bloop! Ice cream, please!
    dutchClip: {fileID: 8300000, guid: edf6158381b80624182999c2de4433fa, type: 3}
    englishClip: {fileID: 0}
  - key: shop.dragon_arrives.1
    group: shop.dragon_arrives
    speaker: 3
    dutch: Wie komt daar aan? De draak wil ook een ijsje!
    english: Who's coming? The dragon wants an ice cream too!
    dutchClip: {fileID: 8300000, guid: 3e82becd698ecc241ae58d32e71b1099, type: 3}
    englishClip: {fileID: 0}
  - key: shop.hello.dragon.1
    group: shop.hello.dragon
    speaker: 2
    dutch: Grrroaar! Ijsje! Een groot ijsje!
    english: Grrroar! Ice cream! A big ice cream!
    dutchClip: {fileID: 8300000, guid: 384df64b60de9a047a58a0d17050dd7f, type: 3}
    englishClip: {fileID: 0}
  - key: shop.order.1.pink.1
    group: shop.order.1.pink
    speaker: 3
    dutch: "E\xE9n roze bolletje."
    english: One pink scoop.
    dutchClip: {fileID: 8300000, guid: 91dff384284c3be4ba47c4d9b644b61e, type: 3}
    englishClip: {fileID: 0}
  - key: shop.order.2.pink.1
    group: shop.order.2.pink
    speaker: 3
    dutch: Twee roze bolletjes.
    english: Two pink scoops.
    dutchClip: {fileID: 8300000, guid: 3094beacfdb83e9458d429ba61b7492d, type: 3}
