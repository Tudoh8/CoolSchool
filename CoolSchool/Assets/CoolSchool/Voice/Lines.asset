    english: The little dragon is called Guus!
    dutchClip: {fileID: 8300000, guid: d578c52f7c83334458ccaa85c754aaf2, type: 3}
    englishClip: {fileID: 0}
  - key: castle.baby_named.f.1
    group: castle.baby_named.f
    speaker: 1
    dutch: Het draakje heet Fikkie!
    english: The little dragon is called Fikkie!
    dutchClip: {fileID: 8300000, guid: 5a73d7ae18ce52c4e93acfedeb7db8f6, type: 3}
    englishClip: {fileID: 0}
  - key: castle.baby_named.u.1
    group: castle.baby_named.u
    speaker: 1
    dutch: Het draakje heet Ukkie!
    english: The little dragon is called Ukkie!
    dutchClip: {fileID: 8300000, guid: f2ed3803ade3f1e4eab82201f17a84f8, type: 3}
    englishClip: {fileID: 0}
  - key: castle.baby_buddy.1
    group: castle.baby_buddy
    speaker: 1
    dutch: Het draakje wil met jou mee! Het is nu jouw vriendje!
    english: The little dragon wants to come with you! Now it's your buddy!
    dutchClip: {fileID: 8300000, guid: 7a9788cc2f929c0469f5dc0f0bb9a361, type: 3}
    englishClip: {fileID: 0}
  - key: castle.dragon_friend.1
    group: castle.dragon_friend
    speaker: 2
    dutch: Dankjewel! Nu zijn we vrienden. Klim maar op mijn rug!
    english: Thank you! Now we're friends. Climb onto my back!
    dutchClip: {fileID: 8300000, guid: 5024e50a95aaf9c4b9790b63f541c732, type: 3}
    englishClip: {fileID: 0}
  - key: castle.ride_start.1
    group: castle.ride_start
    speaker: 1
    dutch: Houd je goed vast! Tik op de knop voor confettivuur!
    english: Hold on tight! Tap the button for confetti fire!
    dutchClip: {fileID: 8300000, guid: cc735a841d095784e87d07e67a63877f, type: 3}
    englishClip: {fileID: 0}
  - key: castle.ride_land.1
    group: castle.ride_land
    speaker: 2
    dutch: Daar zijn we weer!
    english: Here we are again!
    dutchClip: {fileID: 8300000, guid: bd0ab65adb694d946be65dc49a4c11c2, type: 3}
    englishClip: {fileID: 0}
  - key: castle.flag.1
    group: castle.flag
    speaker: 1
    dutch: 'Voor jou, ridder: een vlag met jouw naam! Met welke letter begint jouw
      naam?'
    english: 'For you, knight: a flag with your name! Which letter does your name
      start with?'
    dutchClip: {fileID: 8300000, guid: 825c824115b66f6489cafa0da63db8c0, type: 3}
    englishClip: {fileID: 0}
  - key: castle.flag_done.1
    group: castle.flag_done
    speaker: 1
    dutch: Kijk! Jouw naam op de vlag!
    english: Look! Your name on the flag!
    dutchClip: {fileID: 8300000, guid: 25a32dcd0bb77194d94302c247784b5f, type: 3}
    englishClip: {fileID: 0}
  - key: castle.grow.1
    group: castle.grow
    speaker: 1
    dutch: 'En kijk: er staat een nieuwe vlag op het kasteel!'
    english: 'And look: there''s a new flag on the castle!'
    dutchClip: {fileID: 8300000, guid: 38bd792f5f107904e9946eebe72aceec, type: 3}
    englishClip: {fileID: 0}
  - key: castle.victory.1
    group: castle.victory
    speaker: 1
    dutch: Hoera! Jullie hebben het kasteel gered! Feest!
    english: Hooray! You saved the castle! Party time!
    dutchClip: {fileID: 8300000, guid: 1afdaae9557b74c459dcfa01e462a3e2, type: 3}
    englishClip: {fileID: 0}
  - key: castle.dragon_bye.1
    group: castle.dragon_bye
    speaker: 2
    dutch: Dag! Tot de volgende keer!
    english: Bye! See you next time!
    dutchClip: {fileID: 8300000, guid: 8eefd0dbf762efa4a88896c42e1a039c, type: 3}
    englishClip: {fileID: 0}
  - key: invite.zoo.1
    group: invite.zoo
    speaker: 0
    dutch: Help! De dieren uit de dierentuin zijn ontsnapt! Kom je zoeken?
    english: Help! The zoo animals have escaped! Will you come and look?
    dutchClip: {fileID: 8300000, guid: f71b744313324544f8eaaab214cef4a1, type: 3}
    englishClip: {fileID: 0}
  - key: zoo.start.1
    group: zoo.start
    speaker: 1
    dutch: Help! Ik ben de dierenverzorger, en de dieren zijn ontsnapt!
    english: Help! I'm the zookeeper, and the animals have escaped!
    dutchClip: {fileID: 8300000, guid: ac02f18a03b2a284d8b8aafddf86d4a8, type: 3}
    englishClip: {fileID: 0}
  - key: zoo.escaped.1
    group: zoo.escaped
    speaker: 1
    dutch: Ze hebben zich verstopt in het park. Zoek jij mee?
    english: They're hiding in the park. Will you help me look?
    dutchClip: {fileID: 8300000, guid: 40deb770371e19c4697cea07ad673450, type: 3}
    englishClip: {fileID: 0}
  - key: zoo.close_eyes.1
    group: zoo.close_eyes
    speaker: 1
    dutch: Eerst ogen dicht en tellen! Tel je mee?
    english: First close your eyes and count! Count with me?
    dutchClip: {fileID: 8300000, guid: 62274846bc44b1c458247f3ad886c6d2, type: 3}
    englishClip: {fileID: 0}
  - key: zoo.ready.1
    group: zoo.ready
    speaker: 1
    dutch: Wie niet weg is, is gezien! We komen eraan!
    english: Ready or not, here we come!
    dutchClip: {fileID: 8300000, guid: 1ffd90ebcb3b50047a753aa8aa561136, type: 3}
    englishClip: {fileID: 0}
  - key: zoo.found_new.1
    group: zoo.found_new
    speaker: 1
    dutch: Een nieuw dier!
    english: A new animal!
    dutchClip: {fileID: 8300000, guid: 40402b228b3c9444e95b7d32d92d2083, type: 3}
    englishClip: {fileID: 0}
  - key: zoo.found.elephant.1
    group: zoo.found.elephant
    speaker: 1
    dutch: Gevonden! De olifant!
    english: Found you! The elephant!
    dutchClip: {fileID: 8300000, guid: 47660a0410b4f9a46acbb4700f78f6a3, type: 3}
    englishClip: {fileID: 0}
  - key: zoo.found.giraffe.1
    group: zoo.found.giraffe
    speaker: 1
    dutch: Gevonden! De giraf!
    english: Found you! The giraffe!
    dutchClip: {fileID: 8300000, guid: b38857ff3329ac7459bec3e50e2caf16, type: 3}
    englishClip: {fileID: 0}
  - key: zoo.found.monkey.1
    group: zoo.found.monkey
    speaker: 1
    dutch: Gevonden! De aap!
    english: Found you! The monkey!
    dutchClip: {fileID: 8300000, guid: aaa3f5bbc86d68f469d5bb7225d0dc59, type: 3}
    englishClip: {fileID: 0}
  - key: zoo.found.penguin.1
    group: zoo.found.penguin
    speaker: 1
    dutch: "Gevonden! De pingu\xEFn!"
    english: Found you! The penguin!
    dutchClip: {fileID: 8300000, guid: 583132e92d386584ca542032efd72c3f, type: 3}
    englishClip: {fileID: 0}
  - key: zoo.found.hippo.1
    group: zoo.found.hippo
    speaker: 1
    dutch: Gevonden! Het nijlpaard!
    english: Found you! The hippo!
    dutchClip: {fileID: 8300000, guid: 60b689c1cab2c3241bd6369e6b385e38, type: 3}
    englishClip: {fileID: 0}
  - key: zoo.found.lion.1
