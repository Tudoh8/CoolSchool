%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9e2ac7d7808755a4f94b76b97ea6f80b, type: 3}
  m_Name: Lines
  m_EditorClassIdentifier: Assembly-CSharp::CoolSchool.Voice.LineTable
  lines:
  - key: general.welcome.1
    group: general.welcome
    speaker: 0
    dutch: Hoi! Wat fijn dat je er bent. Kom, we gaan spelen!
    english: Hi! So nice to see you. Come on, let's play!
    dutchClip: {fileID: 8300000, guid: e896d6acc3e64d64e99d62ab8752f341, type: 3}
    englishClip: {fileID: 0}
  - key: tag.start.1
    group: tag.start
    speaker: 0
    dutch: Tikkertje! Jij bent hem. Tik de andere kinderen!
    english: Tag! You're it. Go and tag the other kids!
    dutchClip: {fileID: 8300000, guid: c4fb98c408bb18c48ad89faf5f3321d5, type: 3}
    englishClip: {fileID: 0}
  - key: tag.tagged_someone.1
    group: tag.tagged_someone
    speaker: 1
    dutch: Oh nee, getikt!
    english: Oh no, you got me!
    dutchClip: {fileID: 8300000, guid: 6066d6798af10e643bd13434d46a1ac6, type: 3}
    englishClip: {fileID: 0}
  - key: tag.tagged_someone.2
    group: tag.tagged_someone
    speaker: 1
    dutch: Haha, jij bent snel!
    english: Haha, you're fast!
    dutchClip: {fileID: 8300000, guid: dc3e8ff29aefc5e46a105870763d22ef, type: 3}
    englishClip: {fileID: 0}
  - key: tag.tagged_someone.3
    group: tag.tagged_someone
    speaker: 1
    dutch: "Ok\xE9, nu ben ik hem!"
    english: Okay, now I'm it!
    dutchClip: {fileID: 8300000, guid: 05caa4ad3b0773244ac14c3667d90e90, type: 3}
    englishClip: {fileID: 0}
  - key: tag.became_it.1
    group: tag.became_it
    speaker: 1
    dutch: Hihi, nu ben jij hem!
    english: Hehe, now you're it!
    dutchClip: {fileID: 8300000, guid: 665d729a9da1ca747b8e3244fa0345d9, type: 3}
    englishClip: {fileID: 0}
  - key: tag.became_it.2
    group: tag.became_it
    speaker: 1
    dutch: Getikt! Jij bent hem!
    english: Tagged! You're it!
    dutchClip: {fileID: 8300000, guid: 5a5aa85a31939dc48b7d55ae3295f46e, type: 3}
    englishClip: {fileID: 0}
  - key: tag.round_finished.1
    group: tag.round_finished
    speaker: 0
    dutch: Wat een goed spel! Even uitrusten.
    english: What a great game! Time for a little rest.
    dutchClip: {fileID: 8300000, guid: c26141b25d27cc444b696e61e13e59f1, type: 3}
    englishClip: {fileID: 0}
  - key: knights.start.1
    group: knights.start
    speaker: 0
    dutch: Ridders! Bescherm het kasteel! Tik op de knop om met je zwaard te zwaaien.
    english: Knights! Protect the castle! Tap the button to swing your sword.
    dutchClip: {fileID: 8300000, guid: 61d267b59e8124448b54561c9df6370e, type: 3}
    englishClip: {fileID: 0}
  - key: knights.shield_hint.1
    group: knights.shield_hint
    speaker: 0
    dutch: Houd de knop ingedrukt, dan pak je je schild!
    english: Hold the button down to raise your shield!
    dutchClip: {fileID: 8300000, guid: 30f54307655942943b6b3526bb9dbfdb, type: 3}
    englishClip: {fileID: 0}
  - key: knights.wave.1
    group: knights.wave
    speaker: 1
    dutch: Daar komen de kobolden!
    english: Here come the goblins!
    dutchClip: {fileID: 8300000, guid: 490d9caf438ee8f41b1c485b6af60418, type: 3}
    englishClip: {fileID: 0}
  - key: knights.wave_more.1
    group: knights.wave_more
    speaker: 1
    dutch: Nog meer kobolden!
    english: Even more goblins!
    dutchClip: {fileID: 8300000, guid: c5027b4def3c66b40b92bcd98239cb17, type: 3}
    englishClip: {fileID: 0}
  - key: knights.goblin_down.1
    group: knights.goblin_down
    speaker: 2
    dutch: Hihihi, je hebt me!
    english: Hehehe, you got me!
    dutchClip: {fileID: 8300000, guid: 3c93792ebfdb12047a0b8fe93c6ec308, type: 3}
    englishClip: {fileID: 0}
  - key: knights.goblin_down.2
    group: knights.goblin_down
    speaker: 2
    dutch: Oei, ik val om!
    english: Whoops, I'm falling over!
    dutchClip: {fileID: 8300000, guid: 440cd45ff01dc914e99ca910372a4c6d, type: 3}
    englishClip: {fileID: 0}
  - key: knights.goblin_down.3
    group: knights.goblin_down
    speaker: 2
    dutch: Haha, jij bent sterk!
    english: Haha, you're strong!
    dutchClip: {fileID: 8300000, guid: 20167c59c14102247a4b067dde60a10d, type: 3}
    englishClip: {fileID: 0}
  - key: knights.dragon.1
    group: knights.dragon
    speaker: 0
    dutch: Kijk! Een draak! Hij wil alleen spelen. Pas op voor zijn confettivuur!
    english: Look! A dragon! He just wants to play. Watch out for his confetti fire!
    dutchClip: {fileID: 8300000, guid: 98e9784cc6651ea43ab08b5d5e1e1246, type: 3}
    englishClip: {fileID: 0}
  - key: knights.fire_warning.1
    group: knights.fire_warning
    speaker: 1
    dutch: Schild omhoog!
    english: Shields up!
    dutchClip: {fileID: 8300000, guid: bf20463105d46bc46b74b48892ca8522, type: 3}
    englishClip: {fileID: 0}
  - key: knights.fire_warning.2
    group: knights.fire_warning
    speaker: 1
    dutch: Pas op, vuur!
    english: Watch out, fire!
    dutchClip: {fileID: 8300000, guid: 1e6408e190b817344af2f870edd46b8b, type: 3}
    englishClip: {fileID: 0}
  - key: knights.victory.1
    group: knights.victory
    speaker: 0
    dutch: Hoera! Jullie hebben het kasteel gered!
    english: Hooray! You saved the castle!
    dutchClip: {fileID: 8300000, guid: 27e1aaba590422b46abcc57720a39a72, type: 3}
    englishClip: {fileID: 0}
  - key: reward.star.1
    group: reward.star
    speaker: 3
    dutch: Een ster!
    english: A star!
    dutchClip: {fileID: 8300000, guid: 8faae5b0ca343bf49beafb30bdb6ca98, type: 3}
    englishClip: {fileID: 0}
  - key: reward.jar_full.1
    group: reward.jar_full
    speaker: 0
    dutch: De pot is vol! Je krijgt een cadeautje!
    english: The jar is full! You get a present!
    dutchClip: {fileID: 8300000, guid: c9c036d1e85c8ca4ab894a1050c4453e, type: 3}
    englishClip: {fileID: 0}
  - key: reward.present_tap.1
    group: reward.present_tap
    speaker: 0
    dutch: Tik op het cadeau!
    english: Tap the present!
    dutchClip: {fileID: 8300000, guid: 056d132f5e228524baeeaa77230e9a56, type: 3}
    englishClip: {fileID: 0}
  - key: reward.present_open.1
    group: reward.present_open
    speaker: 0
    dutch: Wauw! Kijk eens wat erin zit!
    english: Wow! Look what's inside!
    dutchClip: {fileID: 8300000, guid: d396c257c73051d4caa34dbe39e8c62c, type: 3}
    englishClip: {fileID: 0}
  - key: invite.tag.1
    group: invite.tag
    speaker: 0
    dutch: Kom, we gaan tikkertje spelen! Volg de sterretjes!
    english: Come on, let's play tag! Follow the stars!
    dutchClip: {fileID: 8300000, guid: 13a80647929acb1469e43e1cfd8ff5d8, type: 3}
    englishClip: {fileID: 0}
  - key: invite.knights.1
    group: invite.knights
    speaker: 0
    dutch: Kom, we gaan ridders spelen bij het kasteel! Volg de sterretjes!
    english: Come on, let's play knights at the castle! Follow the stars!
    dutchClip: {fileID: 8300000, guid: 2e9c7b9000c1d5449a81b6e63d2da1f5, type: 3}
    englishClip: {fileID: 0}
  - key: invite.knights.2
    group: invite.knights
    speaker: 0
    dutch: Zie je dat zwaard daar? Daar is het kasteel!
    english: See that sword over there? That's the castle!
    dutchClip: {fileID: 8300000, guid: f933ceacd75e92c4d87095a29bd6c6d7, type: 3}
    englishClip: {fileID: 0}
  - key: number.1.1
    group: number.1
    speaker: 0
    dutch: "E\xE9n"
    english: One
    dutchClip: {fileID: 8300000, guid: e897acf2c4ce8954483090c1619fb8a1, type: 3}
    englishClip: {fileID: 0}
  - key: number.2.1
    group: number.2
    speaker: 0
    dutch: Twee
    english: Two
