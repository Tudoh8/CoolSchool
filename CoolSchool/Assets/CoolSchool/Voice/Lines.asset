    englishClip: {fileID: 0}
  - key: lesson.compare_more.1
    group: lesson.compare_more
    speaker: 0
    dutch: Waar zijn er meer? Tik op die kant!
    english: Where are there more? Tap that side!
    dutchClip: {fileID: 8300000, guid: 08dd0bdce97ed9540bbef04e1f92932b, type: 3}
    englishClip: {fileID: 0}
  - key: lesson.compare_fewer.1
    group: lesson.compare_fewer
    speaker: 0
